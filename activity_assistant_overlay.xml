<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80030712">

    <!-- Stark Industries Futuristic Glassmorphic Bottom HUD -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bottom_overlay_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingRight="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="26dp">

        <!-- Top Drag Pill / Arc Power Bar -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/assistant_light_bar" />

        <!-- Header Status Bar with Protocol Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/orb_glow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="J.A.R.V.I.S. MARK VII"
                    android:textColor="#00F2FE"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/card_bg"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="BOSS ACTIVE"
                    android:textColor="#38EF7D"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Close HUD Button -->
            <ImageView
                android:id="@+id/closeBtn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/card_bg"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </RelativeLayout>

        <!-- User Voice Command Transcript -->
        <TextView
            android:id="@+id/overlayUserText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Listening, Boss..."
            android:textColor="#00F2FE"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- JARVIS Voice Response Bubble -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/overlayResponseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Hello Boss! Boliye kya hukum hai?"
                android:textColor="#F1F5F9"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Futuristic Action Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Left Tool Icons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/lensBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/card_bg"
                    android:clickable="true"
                    android:contentDescription="Visual Lens"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Google Lens"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Center Arc Reactor Mic Button -->
            <ImageView
                android:id="@+id/overlayMicBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/orb_center"
                android:clickable="true"
                android:contentDescription="Mic Trigger"
                android:focusable="true"
                android:padding="12dp"
                android:src="@android:drawable/ic_btn_speak_now" />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>
