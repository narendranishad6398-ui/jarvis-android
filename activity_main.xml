<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header Title: Stark Industries JARVIS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.25"
            android:text="J.A.R.V.I.S."
            android:textColor="#00F2FE"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.15"
            android:text="STARK INDUSTRIES • AUTONOMOUS AI PROTOCOL"
            android:textColor="#4FACFE"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Center Glowing Arc Reactor Core Visual -->
        <FrameLayout
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_glow" />

            <Button
                android:id="@+id/testMicBtn"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@drawable/orb_center"
                android:text="TEST\nJARVIS"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Realtime System Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="● 24/7 Silent Ear • Standby"
                    android:textColor="#38EF7D"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/serviceSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:checked="true" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#1E293B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Triggers: 'Hey Jarvis', 'Jarvis', 'Stark', 'Computer', 'Assistant'"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 1-Click Master Setup Button -->
        <Button
            android:id="@+id/grantAllBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/btn_cyan"
            android:elevation="4dp"
            android:letterSpacing="0.05"
            android:text="⚡ GRANT ALL PERMISSIONS &amp; START"
            android:textColor="#030712"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Accessibility Service Button for Universal In-App Control -->
        <Button
            android:id="@+id/accessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_bg"
            android:text="📲 Turn On Accessibility (In-App &amp; Net Controls)"
            android:textColor="#00F2FE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Custom Voice Unlock Password Button -->
        <Button
            android:id="@+id/voicePasswordBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/card_bg"
            android:text="🔑 Set Custom Voice Unlock Password"
            android:textColor="#38EF7D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Permissions & Settings Sub-panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ADVANCED PROTOCOLS"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/overlayPermBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/card_bg"
                android:text="Enable Floating Window Overlay"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/batteryOptBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/card_bg"
                android:text="Ignore Battery Optimization (24/7 Run)"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/defaultAssistantBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/card_bg"
                android:text="Set JARVIS as Default Phone Assistant"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/geminiKeyBtn"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/card_bg"
                android:text="Custom Gemini API Key (Optional)"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Command Showcase Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="JARVIS VOICE DIRECTIVES GUIDE"
                android:textColor="#00F2FE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="• Calls: 'Papa ko call karo', 'Call uthao', 'Call kato'\n• Settings: 'Net on/off karo', 'Hotspot on karo', 'Torch jalao'\n• In-App: 'Type karo...', 'Send button dabao', 'Neeche scroll karo'\n• Maps: 'Delhi ka rasta dikhao', 'Start navigation'\n• Entertainment: 'YouTube par Arijit ke gaane chalao'\n• Controls: 'Phone lock karo', 'Screen kholo', 'Silent mode karo'\n• AI Brain: Ask ANY question in Hindi or English"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
